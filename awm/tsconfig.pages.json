{
  // ADVISORY type-check scope: the plugin pages under services/*/pages/* and
  // plugins/*/pages/*.
  //
  // Run via `npm run typecheck:pages` (NOT part of the gating `typecheck`).
  // Pages use SvelteKit-style page-local `$lib/...` aliases that resolve only
  // through the root Vite config; svelte-check cannot load that config under
  // this vite 5.x / @sveltejs/load-config combo ("vite.resolveConfig is not a
  // function"), so `$lib` imports report as unresolved here. Run it to surface
  // real page-source drift, but expect alias-resolution noise.
  "extends": "./tsconfig.json",
  "include": [
    "services/*/pages/**/*.ts",
    "services/*/pages/**/*.svelte",
    "plugins/*/pages/**/*.ts",
    "plugins/*/pages/**/*.svelte"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}
