# graphify indexing policy for the awm source tree.
#
# Consumed by the `graphify` CLI (the awm.graphify service) when it builds a
# knowledge graph of this tree. gitignore semantics, last-match-wins.
#
# Phase 1 is AST-only (no LLM backend, no API key). graphify routes doc/paper/
# image files through a semantic LLM pass and refuses to build them without a
# key, so we exclude all doc-class extensions here to keep the corpus code-only.
# (When semantic doc extraction is wired up later, relax this section.)
*.md
*.mdx
*.qmd
*.rst
*.txt
*.html
*.yaml
*.yml

# Build output, vendored deps, and graphify's own artifacts — never source.
node_modules/
dist/
graphify-out/
__pycache__/
*.egg-info/
.runtime-env
