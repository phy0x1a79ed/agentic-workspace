.runtime-env

# Install artifacts: the unpacked published server (with its own node runtime),
# the absolute node bin install.sh recorded, and what was downloaded. Beside the
# service rather than in workspace state, because the user that installs and the
# user that runs are not the same one everywhere.
server/
node-bin
tarball-stamp
tarball-sha256
