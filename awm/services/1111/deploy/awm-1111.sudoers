# Lets tony drive the u1111-owned webui and viewer processes without any other
# access to u1111's home directory. Exact invocations only — no wildcard
# argument, so this can never be used to run arbitrary commands as u1111.
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh start
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh stop
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh status
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh restart
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh view-start
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh view-stop
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh view-status
tony ALL=(u1111) NOPASSWD: /home/u1111/bin/1111ctl.sh view-restart
