# A user unit template. The sweep installs it into ~/.config/systemd/user/ on a
# node that runs isolated sessions, after it has built the image there.
[Unit]
Description=Rewrite each isolated Claude session's login copy after a host refresh

[Service]
Type=simple
ExecStart=%h/agentic_workspace/awm/services/cch/bin/isolated-login-sync
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
