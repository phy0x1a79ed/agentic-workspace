[Unit]
Description=AWM Opera (Teams web + Slack-web fallback, headless, CDP) on mira
Documentation=awm/services/social/mira/README.md
After=awm-display.service awm-wm.service
Requires=awm-display.service
Wants=awm-wm.service

[Service]
Environment=DISPLAY=:20
# Force X11/Xvfb: the user manager inherits WAYLAND_DISPLAY from tony's idle
# GNOME session, which would otherwise pull the browser onto the wrong display.
UnsetEnvironment=WAYLAND_DISPLAY
# A DEDICATED browser (Opera) so the automation profile never collides with the
# user's own google-chrome on mira. Opens Teams plus app.slack.com — the Slack tab
# is what the API daemon and the extractor both drive.
# --remote-debugging-port binds 127.0.0.1 only (RCE-equivalent surface; never
# expose off-host). --disable-gpu: no GPU under Xvfb. The logins persist under
# ~/snap/opera so a restart comes back signed in.
# --ozone-platform=x11: unsetting WAYLAND_DISPLAY isn't enough — Chromium
# auto-detects the wayland-0 socket in XDG_RUNTIME_DIR and would render to the
# real GNOME compositor instead of our Xvfb. Pin X11. The occlusion flag stops
# Chromium painting the off-screen Xvfb window black.
# The sharepoint.com tab backs the OneDrive bucket (MIRA_STORAGE=onedrive); its
# Microsoft SSO carries over from the Teams login in the same Opera profile.
ExecStartPre=/bin/sleep 2
ExecStart=/snap/bin/opera --remote-debugging-port=9224 --no-first-run --disable-gpu --ozone-platform=x11 --disable-features=CalculateNativeWinOcclusion https://teams.microsoft.com https://app.slack.com https://ubcca.sharepoint.com/teams/ubcMICB-gr-HallamLab
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
