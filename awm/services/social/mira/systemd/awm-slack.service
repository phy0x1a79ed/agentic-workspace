[Unit]
Description=AWM Slack desktop (headless, CDP) on mira
Documentation=awm/services/social/mira/README.md
After=awm-display.service awm-wm.service
Requires=awm-display.service
Wants=awm-wm.service

[Service]
Environment=DISPLAY=:20
# Force X11/Xvfb: the user manager inherits WAYLAND_DISPLAY from tony's idle
# GNOME session, which would otherwise pull the client onto the wrong display.
UnsetEnvironment=WAYLAND_DISPLAY
# --remote-debugging-port binds 127.0.0.1 only (RCE-equivalent surface; never
# expose off-host). The connector's extractor reads creds from this port locally
# on mira. --disable-gpu: no GPU under Xvfb. The login persists under
# ~/snap/slack so a restart comes back logged in (creds are "on-disk for restart").
# --ozone-platform=x11: unsetting WAYLAND_DISPLAY isn't enough — Chromium/Electron
# auto-detect the wayland-0 socket in XDG_RUNTIME_DIR and would render to the real
# GNOME compositor instead of our Xvfb. Pin X11. The occlusion flag stops Chromium
# painting the off-screen Xvfb window black.
ExecStartPre=/bin/sleep 2
ExecStart=/snap/bin/slack --remote-debugging-port=9223 --disable-gpu --ozone-platform=x11 --disable-features=CalculateNativeWinOcclusion
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
