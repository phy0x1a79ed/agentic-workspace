[Unit]
Description=Claude Code background-session daemon
After=network-online.target

[Service]
Type=simple
# Runs outside awm.service, so an awm restart never takes the background sessions with it.
# KillMode=process leaves the sessions running when the daemon itself stops or self-upgrades.
Environment=PATH=%h/.local/bin:%h/lib/miniforge3/condabin:%h/lib/miniforge3/bin:/usr/local/bin:/usr/bin:/bin
Environment=MAMBA_ROOT_PREFIX=%h/lib/miniforge3
ExecStart=%h/.local/bin/claude daemon run --origin service
KillMode=process
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
