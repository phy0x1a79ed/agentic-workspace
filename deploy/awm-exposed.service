[Unit]
Description=AWM network-exposed listener (HTTPS REST + WebSocket)
After=network.target
Wants=awm.service

[Service]
Type=simple
Environment=AWM_WORKSPACE=%h/agentic_workspace
Environment=AWM_IDLE_SHUTDOWN=0
Environment=AWM_EXPOSED_HOST=0.0.0.0
Environment=AWM_EXPOSED_PORT=7820
Environment=AWM_TLS_CERT=%h/.awm/tls/cert.pem
Environment=AWM_TLS_KEY=%h/.awm/tls/key.pem
Environment=AWM_AUTH_TOKEN_FILE=%h/.awm/auth.token
# Set AWM_ALLOW_DESTRUCTIVE=1 only if you trust every caller. Default off.
ExecStart=/home/tony/miniforge3/envs/awm/bin/awm serve-exposed
Restart=on-failure
RestartSec=2
StandardOutput=append:%h/agentic_workspace/.awm/awm-exposed.log
StandardError=append:%h/agentic_workspace/.awm/awm-exposed.log

[Install]
WantedBy=default.target
