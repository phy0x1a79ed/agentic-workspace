# Probe operator credentials.
# Copy to tools/.env.probe (gitignored) and fill in real values.

# --- EMQX signaling ---
# Rotation: change password in EMQX dashboard, update this file,
# restart tools/host_binary.py.
EMQX_URL=wss://s12a68ff.ala.us-east-1.emqxsl.com:8084/mqtt
EMQX_USER=awm_probe
EMQX_PASS=<paste-password-from-emqx-dashboard>

# --- Cloudflare Realtime TURN (optional) ---
# If set, probe_op.py mints a short-lived TURN credential at startup
# and ships it to the friend over the from-operator/turn signaling
# topic. If unset, both sides fall back to STUN-only (may fail under
# strict NAT). Token ID is the TURN key ID from the CF dashboard;
# API token must have "TURN" edit permission scoped to that key.
CF_TURN_TOKEN_ID=<paste-turn-key-id-from-cloudflare>
CF_TURN_API_TOKEN=<paste-cloudflare-api-token>
