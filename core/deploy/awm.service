[Unit]
Description=awm gateway (the Rust core)
After=network.target

[Service]
Type=simple
Environment=AWM_WORKSPACE=%h/agentic_workspace
Environment=AWM_DIR=%h/agentic_workspace/.awm
ExecStart=%h/.local/bin/awm gateway serve --state %h/agentic_workspace/.awm
Restart=on-failure
RestartSec=1
StandardOutput=append:%h/agentic_workspace/.awm/awm.log
StandardError=append:%h/agentic_workspace/.awm/awm.log

[Install]
WantedBy=default.target
