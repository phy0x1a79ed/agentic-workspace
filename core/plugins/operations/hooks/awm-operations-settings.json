{
  "awaySummaryEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|ExitPlanMode|TaskCreate|TaskUpdate|TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/awm-operations-hook.sh 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/awm-operations-hook.sh 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh $HOME/.claude/hooks/awm-operations-hook.sh 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
