{
  "name": "@awm/tts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TTS stripe: text-in → audio-out. Frontend hits ./_api/* on the supervised python backend; backend wraps voice.engines for engine selection + per-call WS PCM streaming.",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "stripe": {
    "frontend": "dist/",
    "prefix": "/tts",
    "backend": {
      "cmd": ["mamba", "run", "-n", "awm", "python", "-m", "tts.backend", "--port", "${AWM_SERVICE_PORT}"],
      "cwd": "../..",
      "health": "/healthz"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "svelte": "^5.2.0",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
