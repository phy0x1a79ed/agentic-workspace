# Stub plugins for the install test's fake fleet: peer/2fa and peer/social for the fake peer, and
# install/hello, a plugin the new node installs. Each folder carries its own copy of
# awm-fake-plugin, so it runs on a node that has nothing else.
ARG NODE_IMAGE=awm-test-node
FROM ${NODE_IMAGE}
COPY plugins /opt/awm-test/plugins
